[Unit]
Description=AmneziaWG Management Panel
After=network.target awg-quick@awg0.service
Wants=awg-quick@awg0.service

[Service]
Type=simple
EnvironmentFile=/etc/awg-panel/panel.env
WorkingDirectory=/opt/awg-panel
ExecStart=/opt/awg-panel/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port ${PANEL_PORT} --app-dir /opt/awg-panel
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
